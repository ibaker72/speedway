# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Inventory
INVENTORY_SOURCE=autofunds
INVENTORY_API_KEY=
INVENTORY_API_BASE_URL=
INVENTORY_FEED_URL=

# Leads & Notifications
LEAD_NOTIFICATION_EMAIL=
LEAD_FROM_EMAIL=
RESEND_API_KEY=

# Admin
DEAL_DESK_ADMIN_PASSWORD=

# Analytics (optional)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_FB_PIXEL_ID=
NEXT_PUBLIC_GTM_ID=

# Site
NEXT_PUBLIC_SITE_URL=https://www.speedwaymotorsllc.com

OPENCLAW_API_KEY=
OPENCLAW_API_BASE_URL=https://api.openclaw.com/v1
OPENCLAW_WEBHOOK_URL=
OPENCLAW_WEBHOOK_SECRET=

# AutoFunds feed — two options (set one):
# Option A: Autofunds pushes a daily CSV to an SFTP server you provision
AUTOFUNDS_SFTP_HOST=
AUTOFUNDS_SFTP_PORT=22
AUTOFUNDS_SFTP_USER=
AUTOFUNDS_SFTP_PASS=
AUTOFUNDS_SFTP_REMOTE_PATH=/uploads   # path to the directory (or exact file) Autofunds drops CSV into
# Option B: pull via a daily-refreshed HTTP URL (legacy)
AUTOFUNDS_FEED_URL=

# Vercel Cron (set in Vercel dashboard, used to authenticate cron job calls)
CRON_SECRET=
