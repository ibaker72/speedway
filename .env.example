# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # server-side only — never expose to browser

# Inventory
INVENTORY_SOURCE=supabase         # supabase | local | feed
INVENTORY_API_KEY=                # secret used by /api/inventory/ingest (generate a random string)

# SFTP — Autofunds drops daily_inventory.csv here
SFTP_HOST=157.230.51.45
SFTP_PORT=22
SFTP_USERNAME=autofunds-upload
SFTP_PASSWORD=                    # server-side only — never expose to browser
SFTP_PRIVATE_KEY=                 # optional alternative to password auth (PEM string)
SFTP_PRIVATE_KEY_PASSPHRASE=      # optional, if private key is encrypted
SFTP_REMOTE_DIR=/speedwaymotors/inventory
SFTP_FILE_NAME=daily_inventory.csv

# Vercel Cron — must match Authorization: Bearer <secret> sent by Vercel
CRON_SECRET=                      # generate: openssl rand -hex 32

# Leads & Notifications
LEAD_NOTIFICATION_EMAIL=
LEAD_FROM_EMAIL=
RESEND_API_KEY=

# Admin
DEAL_DESK_ADMIN_PASSWORD=

# Analytics (optional)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_FB_PIXEL_ID=
NEXT_PUBLIC_GTM_ID=

# Site
NEXT_PUBLIC_SITE_URL=https://www.speedwaymotorsllc.com

# AutoFunds HTTP feed fallback (optional — only used if SFTP_HOST is not set)
AUTOFUNDS_FEED_URL=

# Geo landing page generation — Anthropic Messages API
# Used by /api/generate-city-page (and the weekly geo cron that calls it).
ANTHROPIC_API_KEY=
# Override the model if you need to (default: claude-haiku-4-5-20251001).
ANTHROPIC_MODEL=
# Override the API base URL if you need to (default: https://api.anthropic.com/v1).
ANTHROPIC_API_BASE_URL=
